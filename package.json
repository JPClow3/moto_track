{
  "name": "moto-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "dotenv -e .env -- vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "node db/apply.mjs",
    "db:verify": "node db/verify-migrations.mjs",
    "import:legacy": "tsx scripts/import-legacy-data.ts",
    "worker:dev": "wrangler dev -c workers/reminders/wrangler.toml",
    "worker:deploy": "wrangler deploy -c workers/reminders/wrangler.toml",
    "assets:photos": "node launch-assets/source/prepare-photos.mjs",
    "assets:render": "node launch-assets/source/render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@neondatabase/auth": "^0.4.2-beta",
    "@sentry/browser": "^10.75.0",
    "@sveltejs/adapter-cloudflare": "^7.0.5",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "clsx": "^2.1.1",
    "dodopayments": "^2.61.1",
    "jose": "^6.2.15",
    "lucide-svelte": "^0.468.0",
    "marked": "^18.1.3",
    "postgres": "^3.4.9",
    "svelte": "^5.57.3",
    "sveltekit-superforms": "^2.27.1",
    "uuid": "^11.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/package": "^2.3.12",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.6.2",
    "devalue": "5.9.4",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.31.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "better-auth": "1.6.25",
    "@better-auth/core": "1.6.25",
    "@better-auth/telemetry": "1.6.25",
    "@better-auth/passkey": "1.6.25",
    "sharp": "$sharp",
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "source-map-js": "1.2.2",
    "undici": "7.29.1",
    "postcss-selector-parser@6": "6.1.5",
    "postcss-selector-parser@7": "7.1.6"
  }
}
